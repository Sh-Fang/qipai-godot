[gd_scene load_steps=2 format=3]

[ext_resource path="res://scripts/main.gd" type="Script" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 42.0
offset_right = -48.0
offset_bottom = -42.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "DouZero 斗地主"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.85, 1)
theme_override_font_sizes/font_size = 18
text = "Godot 4 离线 AI 原型"

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.9, 0.55, 1)
theme_override_font_sizes/font_size = 20
text = "检查中..."

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CheckModels" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "检查模型文件"

[node name="NextStep" type="Button" parent="Margin/VBox/Buttons"]
layout_mode = 2
text = "查看下一步"

[node name="Log" type="Label" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.8, 0.84, 0.92, 1)
theme_override_font_sizes/font_size = 18
text = "加载中..."

[connection signal="pressed" from="Margin/VBox/Buttons/CheckModels" to="." method="_on_check_models_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/NextStep" to="." method="_on_next_step_pressed"]
